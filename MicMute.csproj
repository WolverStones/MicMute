<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>mic_on.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI alignment: these properties drive the source-generated
         ApplicationConfiguration.Initialize() that Program.cs calls. Without
         ApplicationHighDpiMode the generator emits SetHighDpiMode(SystemAware),
         which contradicts the manifest's PerMonitorV2 and produces clipped
         controls on 125%/150% displays. ApplicationDefaultFont sets the
         ambient font for controls that inherit (G6: explicit Font=... wins). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <Version>2.4.0</Version>
    <Description>Global-hotkey microphone mute/unmute tray utility</Description>
    <Product>MicMute</Product>
    <Company>itsNate</Company>
    <Authors>itsNate</Authors>
    <Copyright>Copyright (c) 2026 itsNate</Copyright>
    <AssemblyName>MicMute</AssemblyName>
    <RootNamespace>MicMute</RootNamespace>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CA1416</NoWarn>
    <!-- Flat-layout repo: MicMute.csproj sits at the root, so the SDK glob
         would otherwise sweep MicMute.Tests/**/*.cs into this assembly. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MicMute.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="mic_on.ico" LogicalName="mic_on.ico" />
    <EmbeddedResource Include="mic_off.ico" LogicalName="mic_off.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MicMute.Tests" />
  </ItemGroup>

</Project>
